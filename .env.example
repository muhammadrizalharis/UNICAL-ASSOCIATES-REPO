# UNICAL ASSOCIATES REPO — contoh environment
# Salin menjadi .env lalu isi semua nilai kosong. JANGAN commit file .env.
#
# Membuat nilai acak:
#   openssl rand -base64 36

# ── Umum ──
TZ=Asia/Makassar
# Subdomain resmi kampus BELUM aktif — ajukan dulu ke tim IT (lihat README §21.B).
# Selama menunggu, akses lewat port lokal di bawah ini.
APP_URL=http://127.0.0.1:48080

# ── PostgreSQL (instance milik UNICAL sendiri) ──
POSTGRES_USER=unical
POSTGRES_DB=unical
POSTGRES_PASSWORD=
POSTGRES_PORT=48432

# ── Redis (cache, queue, session) ──
REDIS_PASSWORD=
REDIS_PORT=48379

# ── Meilisearch ──
MEILI_MASTER_KEY=
MEILI_PORT=48700

# ── MinIO (object storage S3) ──
MINIO_ROOT_USER=unical
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=unical-assets
MINIO_PORT=48900
MINIO_CONSOLE_PORT=48901

# ── Reverse proxy (dipakai mulai Milestone 2) ──
HTTP_PORT=48080

# ── Backend API ──
API_PORT=48000
# Rahasia penandatangan token; buat dengan: openssl rand -base64 48
JWT_SECRET=

# ── Pintu masuk terpisah per peran ──
# Anggota biasa   : /welcome/
# Admin & moderator: /welcome/<ADMIN_GATE>
# Super admin      : /welcome/<SUPER_ADMIN_GATE>
# Ganti nilainya di lingkungan produksi.
ADMIN_GATE=assoc=-01
SUPER_ADMIN_GATE=assoc=-000

# ── Integrasi eksternal ──
# Alamat email untuk polite pool CrossRef; respons jadi lebih cepat & stabil.
CROSSREF_MAILTO=admin@unismuh.ac.id
