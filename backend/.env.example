# backend/.env — HANYA untuk perintah Prisma CLI DI HOST
# (prisma migrate / generate / seed / studio yang dijalankan dari folder backend).
#
# Saat aplikasi berjalan di Docker, DATABASE_URL disuntik otomatis oleh
# docker-compose (ke host internal "postgres:5432"), jadi berkas ini TIDAK
# diperlukan hanya untuk menghidupkan aplikasi dengan `docker compose up`.
#
# Untuk menjalankan Prisma dari host, arahkan ke Postgres Docker yang
# dipublikasikan di 127.0.0.1:48432. Ganti <POSTGRES_PASSWORD> dengan nilai
# POSTGRES_PASSWORD yang sama seperti di ../.env (root).
DATABASE_URL="postgresql://unical:<POSTGRES_PASSWORD>@localhost:48432/unical?schema=public"
